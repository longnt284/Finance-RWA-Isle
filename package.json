{
  "name": "finance-rwa-isle",
  "version": "1.0.0",
  "description": "A real-time personal-finance archipelago built with React and Three.js.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:i18n && npm run test:shape && npm run test:prices && npm run test:news && npm run test:fishing && npm run test:shop",
    "test:i18n": "node tests/i18n_keys.cjs",
    "test:prices": "node tests/price_providers.cjs",
    "test:news": "node tests/news_feed.cjs",
    "test:fishing": "node tests/fishing.cjs",
    "test:shop": "node tests/shop_catalog.cjs",
    "test:feed": "node tests/feed_language.cjs",
    "test:ui": "node tests/ui_audit.cjs --out .artifacts/ui-audit",
    "test:features": "node tests/feature_shots.cjs --out .artifacts/features",
    "test:panels": "node tests/panel_shots.cjs --out .artifacts/panels",
    "test:photo": "node tests/photo_camera.cjs --out .artifacts/photo",
    "test:exam": "node tests/exam_pass.cjs --out .artifacts/panels",
    "test:fish": "node tests/fishing_play.cjs",
    "test:shape": "node tests/island_shape.cjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
