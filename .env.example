# ---------------------------------------------------------------------------
# Nguồn giá cổ phiếu
# ---------------------------------------------------------------------------
# Mặc định cho Vercel hoặc bất kỳ host nào chạy sẵn hàm /api/quotes cùng origin.
VITE_EQUITY_FEED_URL=/api/quotes

# Nếu frontend và proxy nằm ở hai domain khác nhau, dùng URL tuyệt đối:
# VITE_EQUITY_FEED_URL=https://market-api.example.com/api/quotes

# ---------------------------------------------------------------------------
# Tài khoản người dùng (tuỳ chọn)
# ---------------------------------------------------------------------------
# Bỏ trống hai biến dưới thì ứng dụng chạy ở chế độ lưu-trên-máy: mọi tính năng
# vẫn đầy đủ, chỉ không đồng bộ được giữa các thiết bị. Giao diện nói rõ điều đó.
#
# Trước khi bật, chạy supabase/migrations/0001_isle_saves.sql trên dự án của bạn
# để tạo bảng và các policy Row Level Security.
#
# Chỉ dùng publishable key (anon). KHÔNG bao giờ đặt service_role key vào biến
# VITE_* — mọi biến VITE_* đều được nhúng thẳng vào bundle phía trình duyệt.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
